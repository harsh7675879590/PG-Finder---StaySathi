# LLM API Keys (Provide at least one: OpenAI or Groq)
OPENAI_API_KEY=
GROQ_API_KEY=

# LLM Model Selection (openai: gpt-4o-mini | groq: llama-3.3-70b-versatile)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Speech Services
# Voice: hi-IN-SwaraNeural or en-IN-NeerjaNeural (Free high-clarity Indian neural voices via edge-tts)
DEFAULT_TTS_VOICE=hi-IN-SwaraNeural
ELEVENLABS_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./storage/staysathi.db
RECORDINGS_DIR=./storage/recordings

